PORT=5001
MONGO_URI=mongodb://localhost:27017/loksamadhan
JWT_SECRET=your-jwt-secret-here
CLIENT_URL=http://localhost:5173

# Cloudinary configuration
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=loksamadhan

# Translation — default uses MyMemory (free, no key needed).
# Set this to switch to Google Cloud Translation v2 (better quality, 500k chars/month free).
GOOGLE_TRANSLATE_KEY=
# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Groq Cloud API for AI Vision (qwen/qwen3.8-27b, falls back to qwen/qwen3.6-27b)
# Free key from console.groq.com. If not set, resolution proof falls back to manual verification.
GROQ_API_KEY=

# Nodemailer / SMTP Email Configuration
# For Gmail: use smtp.gmail.com with port 587 and 16-character Google App Password
EMAIL_SERVICE=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-char-app-password
EMAIL_FROM="LokSamadhan Portal <no-reply@loksamadhan.gov.in>"
