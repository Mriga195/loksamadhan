PORT=5001
MONGO_URI=mongodb://localhost:27017/loksamadhan
JWT_SECRET=your-jwt-secret-here
CLIENT_URL=http://localhost:5173

# Cloudinary configuration
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=loksamadhan

# Translation — default uses MyMemory (free, no key needed).
# Set this to switch to Google Cloud Translation v2 (better quality, 500k chars/month free).
GOOGLE_TRANSLATE_KEY=
# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Groq Cloud API for AI Vision (Llama 3.2 Vision)
# Free key from console.groq.com. If not set, falls back gracefully to heuristic verification.
GROQ_API_KEY=
